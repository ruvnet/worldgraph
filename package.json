{
  "name": "worldgraphs",
  "version": "0.1.4",
  "description": "AI coding agent for building digital twins with worldgraph — architect, implement, review, and test the Rust spatial/sensor-graph crates",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/worldgraph.git"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/worldgraph/issues"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "worldgraphs": "bin/cli.js",
    "worldgraph": "bin/cli.js"
  },
  "files": [
    "bin/**",
    "!bin/*.test.js",
    "dist/**",
    "src/**",
    ".harness/**",
    "tsconfig.json",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "SYSTEM.md",
    "LICENSE*",
    "install.md",
    ".claude/**",
    ".claude-plugin/**",
    ".codex/**",
    ".openclaw/**",
    ".opencode/**",
    ".vscode/**",
    ".github/copilot-instructions.md",
    "cli-config.yaml",
    "optional-mcps/**",
    "trust.json",
    "rvm.manifest.toml",
    "capability-table.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "init": "node ./bin/cli.js init",
    "doctor": "node ./bin/cli.js doctor",
    "prepare": "tsc",
    "test:harness": "node --test bin/harness.test.js",
    "rulab:verify": "node bin/cli.js rulab verify"
  },
  "dependencies": {
    "@metaharness/kernel": "0.1.8",
    "@metaharness/host-claude-code": "0.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "digital-twin",
    "world-model",
    "spatial-computing",
    "environmental-monitoring",
    "knowledge-graph",
    "sensor-fusion",
    "ambient-intelligence",
    "ai-agent",
    "agent-harness",
    "coding-agent",
    "rust",
    "wifi-sensing",
    "occupancy",
    "provenance"
  ],
  "publishConfig": {
    "access": "public"
  }
}
